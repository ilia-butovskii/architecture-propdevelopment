        <mxCell id="jNR3_LeHWLUayHGNIU49-96" value="Потеря доверия клиентов. Некорректные финансовые расчеты,&amp;nbsp;&lt;br&gt;некорректное выставление счетов" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="jNR3_LeHWLUayHGNIU49-95">
